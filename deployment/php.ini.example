; Apply via Xneelo PHP settings, or ask support. .user.ini support is host-dependent.
memory_limit = 256M
max_input_vars = 5000
upload_max_filesize = 32M
post_max_size = 40M
max_execution_time = 120
display_errors = Off
log_errors = On
session.cookie_secure = 1
session.cookie_httponly = 1
expose_php = Off
