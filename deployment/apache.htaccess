# Merge with existing rules; do not overwrite an established site's configuration.
Options -Indexes
<FilesMatch "^(config\.php|config-dist\.php|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|Gruntfile\.js)$">
    Require all denied
</FilesMatch>
<FilesMatch "(^\.|\.(sql|mbz|log|ini|bak|env)$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
