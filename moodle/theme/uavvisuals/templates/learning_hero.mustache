<section class="uav-learning-hero" aria-label="{{brandname}}">
    <div class="uav-hero-copy">
        <p class="uav-eyebrow">{{eyebrow}}</p>
        <h2>{{herotitle}}</h2>
        <p class="uav-hero-body">{{herobody}}</p>
        <a class="btn btn-primary uav-course-link" href="{{coursesurl}}">{{courseslabel}} <span aria-hidden="true">↗</span></a>
        <span class="uav-hero-detail">{{herodetail}}</span>
    </div>
    <div class="uav-hero-image" aria-hidden="true"><img src="{{imageurl}}" alt="" width="1200" height="800" loading="lazy"></div>
</section>
